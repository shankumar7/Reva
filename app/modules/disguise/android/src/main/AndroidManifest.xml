<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <!-- keeps a call going when you leave the app or lock the screen; shows as a plain "Timer" notification -->
    <service android:name="expo.modules.disguise.CallService" android:exported="false" android:foregroundServiceType="microphone" />
  </application>
</manifest>
